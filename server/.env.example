PORT=5000
DATABASE_URL=mysql://user:password@127.0.0.1:3306/wedding_planner
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# -------------------------------------------------------------
# REAL EMAIL NOTIFICATION & PASSWORD RESET CONFIGURATION
# -------------------------------------------------------------
# OPTION 1: Resend API (Recommended - 3,000 free emails/month at resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# OPTION 2: SMTP / Gmail Nodemailer Configuration
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Wedding Planner Platform" <your-email@gmail.com>

# Flutterwave online payment api key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key_here
